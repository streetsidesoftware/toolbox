{
  "name": "@streetsidesoftware/test-each",
  "version": "1.0.0",
  "description": "Table-driven tests for node:test, written as vitest-style tagged-template tables.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/toolbox.git",
    "directory": "packages/test-each"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "describe.each",
    "node:test",
    "table",
    "tagged-template",
    "test",
    "test.each"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
