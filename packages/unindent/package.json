{
  "name": "@streetsidesoftware/unindent",
  "version": "1.0.0",
  "description": "Remove the common indentation from multi-line strings and template literals.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/toolbox.git",
    "directory": "packages/unindent"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "dedent",
    "indent",
    "multi-line",
    "string",
    "template",
    "unindent"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
