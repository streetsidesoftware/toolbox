{
  "name": "@streetsidesoftware/placeholders",
  "version": "1.0.1",
  "description": "Replace placeholders in a string with values.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/toolbox.git",
    "directory": "packages/placeholders"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "placeholder",
    "replace",
    "string",
    "template"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@streetsidesoftware/test-each": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
