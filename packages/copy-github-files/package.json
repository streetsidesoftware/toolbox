{
  "name": "@streetsidesoftware/copy-github-files",
  "version": "1.0.0",
  "description": "Copy files from a GitHub repository into local files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/toolbox.git",
    "directory": "packages/copy-github-files"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "copy-github-files": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@streetsidesoftware/test-each": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
