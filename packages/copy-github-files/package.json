{
  "name": "@streetsidesoftware/copy-github-files",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Copy files from a GitHub repository into local files. -- Private until verified",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/toolbox.git",
    "directory": "packages/copy-github-files"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "copy-github-files": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "shx rm -rf dist coverage",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
